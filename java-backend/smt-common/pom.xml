<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smt.platform</groupId>
        <artifactId>smt-backend-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>smt-common</artifactId>
    <packaging>jar</packaging>
    <name>smt-common</name>
    <description>公共工具模块：统一响应、全局异常处理、Jackson/CORS 配置、JWT 工具</description>

    <dependencies>
        <!-- spring-boot-starter-web 以 provided 方式引入，由具体业务模块提供运行时环境 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- spring-boot-starter-security 以 provided 方式引入（P0-4 RBAC 骨架） -->
        <!-- 实际运行时由具体业务模块（如 smt-device-service）传递依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            MyBatis-Plus 以 provided 方式引入（M5 BaseEntity/MetaObjectHandler 需要）：
            smt-common 仅声明 BaseEntity 抽象类与 MetaObjectHandler 处理器，
            运行时由具体业务模块（smt-device-service 等）提供 mybatis-plus-spring-boot3-starter。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            JacksonConfig 直接使用 jackson-databind / jackson-datatype-jsr310 的 API，
            故显式声明为 compile。
            说明：jjwt-jackson 会把 jackson-databind 作为 runtime 传递依赖在更近的深度引入，
            若不显式声明，jackson-databind 会被解析为 runtime scope 而无法参与编译。
            jackson 非 servlet 专有，不会污染 reactive 网关。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
