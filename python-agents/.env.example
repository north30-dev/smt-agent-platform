# SMT Python Agents 环境变量模板
#
# 使用方法：
#   cp python-agents/.env.example python-agents/.env
#   然后填入真实值（生产环境必须修改所有 <change-me-*> 占位）
#
# 注意：.env 文件已被 .gitignore 排除（AGENTS.md §4.1），不会提交到仓库
# 字段与 shared/config.py 的 Settings 类一一对应；未列出的字段使用代码默认值。

# ===== 大模型配置 =====
# 提供商：tongyi（通义千问）/ deepseek / openai（兼容 OpenAI 接口的厂商均可）
LLM_PROVIDER=tongyi
LLM_API_KEY=<change-me-llm-api-key>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_EMBED_MODEL=text-embedding-v2

# ===== Milvus 向量库（与 docker-compose 暴露的宿主机端口对齐）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Java device-service 地址（Python Agent 通过 HTTP 调用）=====
DEVICE_SERVICE_BASE_URL=http://localhost:8081

# ===== PostgreSQL（P0-5：文档元数据 / 订单 / 告警 / 工作流持久化）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smt
POSTGRES_USER=smt
POSTGRES_PASSWORD=<change-me-postgres-password>

# ===== 重试与熔断（M1）=====
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0
DEVICE_SERVICE_MAX_RETRIES=2
MILVUS_MAX_RETRIES=2
MILVUS_RETRY_BACKOFF=1.0

# ===== HTTP 连接池复用（m1）=====
HTTP_MAX_CONNECTIONS=100

# ===== 预测参数（M3：原 predict.py 硬编码值配置化）=====
# PREDICT_THRESHOLDS 为 dict，需以 JSON 字符串提供（如下示例）；
# 不设置时使用代码默认值 {TEMP:{max:80,min:20}, VIB:{max:5,min:0}, DEFAULT:{max:100,min:0}}
# PREDICT_THRESHOLDS={"TEMP":{"max":80.0,"min":20.0},"VIB":{"max":5.0,"min":0.0},"DEFAULT":{"max":100.0,"min":0.0}}
PREDICT_MIN_SPAN_HOURS=24
PREDICT_WINDOW_SIZE=100
PREDICT_TREND_THRESHOLD=0.01

# ===== 可观测性 =====
LOG_LEVEL=INFO

# ===== 质量分析 Agent 阈值（Phase 3）=====
QUALITY_AOI_DEFECT_RATE_THRESHOLD=0.02
QUALITY_SPI_SOLDER_PASTE_VOLUME_MIN=50.0
QUALITY_SPI_SOLDER_PASTE_VOLUME_MAX=150.0
QUALITY_MONITOR_WINDOW_HOURS=1
QUALITY_ALERTS_PAGE_SIZE=20

# ===== 调度智能体参数（Phase 3）=====
SCHEDULER_MAX_HORIZON_HOURS=72
SCHEDULER_CHANGEOVER_MINUTES=30
SCHEDULER_DEVICE_MIN_HEALTH_SCORE=85
SCHEDULER_CAPACITY_PER_HOUR=1000

# ===== Agent 编排（orchestrator 调用各子 Agent 的基地址，Phase 3）=====
AGENT_MAINTENANCE_BASE_URL=http://localhost:8002
AGENT_QUALITY_BASE_URL=http://localhost:8003
AGENT_SCHEDULER_BASE_URL=http://localhost:8001

# ===== 运维风险阈值（Phase 1 m：agent-maintenance 健康评分分级）=====
# 健康评分 >= maintenance_risk_low 视为低风险
# maintenance_risk_medium <= 健康评分 < maintenance_risk_low 视为中风险
# 健康评分 < maintenance_risk_medium 视为高风险
MAINTENANCE_RISK_LOW=85
MAINTENANCE_RISK_MEDIUM=60
