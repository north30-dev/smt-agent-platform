# SMT Agent Platform 环境变量模板
#
# 使用方法：
#   cp docker-compose/.env.example docker-compose/.env
#   然后填入真实值（生产环境必须修改所有 <change-me-*> 占位）
#
# 注意：.env 文件已被 .gitignore 排除（AGENTS.md §4.1），不会提交到仓库
#       本 .env.example 是模板文件（.gitignore 第 34 行 !.env.example 显式允许）

# ===== 数据库 PostgreSQL =====
SMT_DB_HOST=postgres
SMT_DB_PORT=5432
SMT_DB_NAME=smt
SMT_DB_USERNAME=smt
SMT_DB_PASSWORD=<change-me-in-production>

# ===== Redis =====
SMT_REDIS_HOST=redis
SMT_REDIS_PORT=6379
SMT_REDIS_PASSWORD=<change-me-in-production>

# ===== JWT 密钥（HS256，长度需 >= 32 字节）=====
SMT_JWT_SECRET=<change-me-min-32-bytes-random-string>

# ===== 服务编排 =====
SMT_DEVICE_SERVICE_HOST=device-service
SMT_DEVICE_SERVICE_PORT=8081

# ===== Kafka =====
SMT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ===== MQTT =====
SMT_MQTT_BROKER=tcp://mosquitto:1883

# ===== OPC UA 采样参数（毫秒，符合 PRD <100ms 契约）=====
SMT_OPCUA_PUBLISHING_INTERVAL_MS=100
SMT_OPCUA_SAMPLING_INTERVAL_MS=50
SMT_OPCUA_QUEUE_SIZE=10

# ===== 管理员凭据（Phase 1 单用户，Phase 2 接 DB 用户表）=====
# 注意：SMT_ADMIN_PASSWORD 是 BCrypt 哈希（非明文密码），必须用单引号包裹
# （$ 字符会被 bash source 解释为变量引用）
# 生成方式：python -c "import bcrypt;print(bcrypt.hashpw(b'your-password',bcrypt.gensalt()).decode())"
# dev 默认值（admin/dev-only-admin）已在 application.yml 内置，注释此行即可使用默认值
SMT_ADMIN_USERNAME=admin
# SMT_ADMIN_PASSWORD='$2a$10$KI7jxWFMeXBVu7QfOoqmquVNgFmSs9dm7FE4UHa63qkm3IoqZWDeO'

# ===== Spring Profile（dev 或 prod）=====
SPRING_PROFILES_ACTIVE=prod

# ===== Phase 2 新增：Milvus 对象存储（minio）凭据 =====
SMT_MINIO_ACCESS_KEY=<change-me-in-production>
SMT_MINIO_SECRET_KEY=<change-me-in-production>

# ===== Phase 2 新增：Milvus 连接（供 python-agents 使用，本地直连宿主机端口）=====
SMT_MILVUS_HOST=localhost
SMT_MILVUS_PORT=19530
