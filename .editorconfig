root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# 前端统一使用 2 空格缩进
[*.{js,jsx,ts,tsx,json,html,css,scss,sass,less,vue}]
indent_size = 2

# YAML 文件保持 2 空格
[*.{yml,yaml}]
indent_size = 2

# Markdown 保留行尾空格（换行用）
[*.md]
trim_trailing_whitespace = false

# Makefile 必须用 Tab
[Makefile]
indent_style = tab
